    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "@types/node": "^22.12.0",
    "typescript": "^5.9.0",
    "vitest": "5.0.5",
    "wrangler": "4.151.3"
  }
}
