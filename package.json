{
  "name": "arabic-pipeline",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Pay-per-call x402 API for Arabic text/audio/document utilities. USDC on Base, no API key for buyers.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "secret": "wrangler secret put GEMINI_API_KEY",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke-paid-route.mjs",
    "smoke:prod": "node scripts/smoke-paid-route.mjs https://arabic-pipeline.arabic-pipeline.workers.dev",
    "check:daily": "node scripts/daily-check.mjs",
    "typecheck": "tsc --noEmit",
    "login": "wrangler login"
  },
  "dependencies": {
    "@x402/core": "2.29.0",
    "@x402/evm": "2.29.0",
    "@x402/extensions": "2.29.0",
    "@x402/hono": "2.29.0",
    "@x402/mcp": "^2.29.0",
    "hono": "4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "@types/node": "^22.12.0",
    "typescript": "^5.9.0",
    "vitest": "5.0.5",
    "wrangler": "^4.156.0"
  }
}
