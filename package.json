{
  "name": "arabic-pipeline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pay-per-call x402 API for Arabic text/audio/document utilities. USDC on Base, no API key for buyers.",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "secret": "wrangler secret put GEMINI_API_KEY",
